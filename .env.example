# Copy this file to .env.local and fill in your own values.

# ── Owner login ────────────────────────────────────────────────────────────
# The email + password for the /admin dashboard. Store the password as a
# SHA-256 hash. To make a hash, run:
#   node -e "console.log(require('crypto').createHash('sha256').update('YOUR-PASSWORD').digest('hex'))"
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD_HASH=paste-the-sha256-hash-here
# Any 30+ random characters; signs the owner session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# ── Google sign-in (NextAuth) ──────────────────────────────────────────────
# Random secret for NextAuth session tokens (generate like the one above).
NEXTAUTH_SECRET=replace-with-a-long-random-string
# The site's own URL — http://localhost:3000 in dev, https://your-domain in prod.
NEXTAUTH_URL=http://localhost:3000
# From https://console.cloud.google.com/apis/credentials — see docs/DEPLOYMENT.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Optional ───────────────────────────────────────────────────────────────
# Enables the admin "Add from photo (AI)" importer.
ANTHROPIC_API_KEY=
# Injected automatically by Vercel when a Blob store is connected.
BLOB_READ_WRITE_TOKEN=
