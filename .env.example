# Copy this file to .env.local and fill in your own values.

# ── Owner login ────────────────────────────────────────────────────────────
# Owner emails for the /admin dashboard (comma-separated for more than one).
# Each can sign in with the shared password, or with their own Google account.
# Store the password as a SHA-256 hash. To make a hash, run:
#   node -e "console.log(require('crypto').createHash('sha256').update('YOUR-PASSWORD').digest('hex'))"
ADMIN_EMAILS=owner@example.com,helper@example.com
ADMIN_PASSWORD_HASH=paste-the-sha256-hash-here
# Any 30+ random characters; signs the owner session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# ── Google sign-in (NextAuth) ──────────────────────────────────────────────
# Random secret for NextAuth session tokens (generate like the one above).
NEXTAUTH_SECRET=replace-with-a-long-random-string
# The site's own URL — http://localhost:3000 in dev, https://your-domain in prod.
NEXTAUTH_URL=http://localhost:3000
# From https://console.cloud.google.com/apis/credentials — see docs/DEPLOYMENT.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (Resend) — powers the "Reet sign-in" code, subscribe + order emails ─
# Free key from https://resend.com → API Keys. Without it, those features hide.
RESEND_API_KEY=
# Optional custom sender once your domain is verified in Resend:
EMAIL_FROM=

# ── Facebook sign-in (optional) ────────────────────────────────────────────
# From https://developers.facebook.com — a "Consumer" app with Facebook Login.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ── Optional ───────────────────────────────────────────────────────────────
# Enables the admin "Add from photo (AI)" importer.
ANTHROPIC_API_KEY=
# Injected automatically by Vercel when a Blob store is connected.
BLOB_READ_WRITE_TOKEN=
